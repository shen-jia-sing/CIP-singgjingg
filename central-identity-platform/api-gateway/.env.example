PORT=5000
JWT_SECRET=replace_with_a_long_random_secret

# Registration + Login run on the SAME EC2 as the gateway (EC2 #1)
REGISTRATION_SERVICE_URL=http://localhost:5001
LOGIN_SERVICE_URL=http://localhost:5002

# Admin runs on EC2 #2, User runs on EC2 #3 -> use their PUBLIC IPs
ADMIN_SERVICE_URL=http://<EC2-2-PUBLIC-IP>:5003
USER_SERVICE_URL=http://<EC2-3-PUBLIC-IP>:5004
